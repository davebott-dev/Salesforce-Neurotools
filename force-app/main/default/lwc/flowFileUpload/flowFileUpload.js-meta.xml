<?xml version="1.0" encoding="UTF-8"?>

<LightningComponentBundle
    xmlns="http://soap.sforce.com/2006/04/metadata">

    <apiVersion>60.0</apiVersion>

    <isExposed>true</isExposed>

    <masterLabel>Flow File Upload</masterLabel>

    <description>
        Custom Flow File Upload with immediate upload confirmation.
    </description>

    <targets>

        <target>lightning__FlowScreen</target>

    </targets>

    <targetConfigs>

        <targetConfig targets="lightning__FlowScreen">


            <!-- ================================= -->
            <!-- INPUTS -->
            <!-- ================================= -->

            <property
                name="fileUploadLabel"
                type="String"
                label="File Upload Label"
                description="Label displayed above the upload component."
            />


            <property
                name="acceptedFormats"
                type="String[]"
                label="Accepted Formats"
                description="File extensions that can be uploaded."
            />


            <property
                name="allowMultipleFiles"
                type="Boolean"
                label="Allow Multiple Files"
            />


            <property
                name="disabled"
                type="Boolean"
                label="Disabled"
            />


            <property
                name="hoverText"
                type="String"
                label="Hover Text"
            />


            <property
                name="relatedRecordId"
                type="String"
                label="Related Record ID"
                description="Record that the uploaded files will be attached to."
            />


            <!-- ================================= -->
            <!-- OUTPUTS -->
            <!-- ================================= -->

            <property
                name="contentDocumentIds"
                type="String[]"
                label="Content Document IDs"
                role="outputOnly"
            />


            <property
                name="contentVersionIds"
                type="String[]"
                label="Content Version IDs"
                role="outputOnly"
            />


            <property
                name="uploadedFileNames"
                type="String[]"
                label="Uploaded File Names"
                role="outputOnly"
            />


        </targetConfig>

    </targetConfigs>

</LightningComponentBundle>