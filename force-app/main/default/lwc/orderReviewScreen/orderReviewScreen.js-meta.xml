<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">

    <apiVersion>66.0</apiVersion>

    <isExposed>true</isExposed>

    <targets>

        <target>lightning__FlowScreen</target>

    </targets>

    <targetConfigs>

        <targetConfig targets="lightning__FlowScreen">

            <!-- ==================================================
                 PRICEBOOK ENTRY COLLECTION
                 ================================================== -->

        <property
    name="productNames"
    type="String[]"
    label="Product Names"
/>

<property
    name="productDescriptions"
    type="String[]"
    label="Product Descriptions"
/>

<property
    name="productPrices"
    type="String[]"
    label="Product Prices"
/>

            <!-- ==================================================
                 ORDER INFORMATION
                 ================================================== -->

            <property
                name="constructName"
                type="String"
                label="Construct Name"
            />

            <property
                name="capsidEnvelope"
                type="String"
                label="Capsid / Envelope"
            />

            <property
                name="virusType"
                type="String"
                label="Virus Type"
            />

            <property
                name="endVolume"
                type="String"
                label="End Volume"
            />

            <property
                name="quantity"
                type="String"
                label="Quantity"
            />

            <property
    name="baselinePassingTiter"
    type="String"
    label="Baseline Passing Titer"
/>


            <!-- ==================================================
                 DNA
                 ================================================== -->

            <property
                name="sendingDNA"
                type="Boolean"
                label="Sending DNA"
            />


            <!-- ==================================================
                 DEFAULT SHIPPING ADDRESS
                 ================================================== -->

            <property
                name="defaultShippingOrganization"
                type="String"
                label="Default Shipping Organization"
            />

            <property
                name="defaultShippingStreet"
                type="String"
                label="Default Shipping Street"
            />

            <property
                name="defaultShippingCity"
                type="String"
                label="Default Shipping City"
            />

            <property
                name="defaultShippingState"
                type="String"
                label="Default Shipping State"
            />

            <property
                name="defaultShippingPostalCode"
                type="String"
                label="Default Shipping Postal Code"
            />

            <property
                name="defaultShippingCountry"
                type="String"
                label="Default Shipping Country"
            />


            <!-- ==================================================
                 OUTPUT SHIPPING ADDRESS
                 ================================================== -->

            <property
                name="shippingOrganization"
                type="String"
                label="Final Shipping Organization"
                role="outputOnly"
            />

            <property
                name="shippingStreet"
                type="String"
                label="Final Shipping Street"
                role="outputOnly"
            />

            <property
                name="shippingCity"
                type="String"
                label="Final Shipping City"
                role="outputOnly"
            />

            <property
                name="shippingState"
                type="String"
                label="Final Shipping State"
                role="outputOnly"
            />

            <property
                name="shippingPostalCode"
                type="String"
                label="Final Shipping Postal Code"
                role="outputOnly"
            />

            <property
                name="shippingCountry"
                type="String"
                label="Final Shipping Country"
                role="outputOnly"
            />

            <property
                name="shippingAddressChanged"
                type="Boolean"
                label="Shipping Address Changed"
                role="outputOnly"
            />

        </targetConfig>

    </targetConfigs>

</LightningComponentBundle>
