<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">

    <apiVersion>66.0</apiVersion>

    <isExposed>true</isExposed>

    <targets>

        <target>lightning__FlowScreen</target>
        <target>lightningCommunity__Page</target>

    </targets>

    <targetConfigs>

        <targetConfig targets="lightning__FlowScreen">

            <!-- INPUT -->

            <property
                name="virusType"
                type="String"
                label="Virus Type"
                description="Virus type used to filter available stock."
                role="inputOnly"
            />
<property
    name="Set_Quantity"
    type="Integer"
    role="inputOnly"
    label="Requested Stock Tubes"
/>

            <!-- OUTPUTS -->

            <property
                name="selectedStockId"
                type="String"
                label="Selected Stock ID"
                role="outputOnly"
            />

            <property
                name="selectedStockName"
                type="String"
                label="Selected Stock Name"
                role="outputOnly"
            />

            <property
                name="selectedStockBatchId"
                type="String"
                label="Selected Stock Batch ID"
                role="outputOnly"
            />

            <property
                name="selectedStockBatchDate"
                type="String"
                label="Selected Stock Batch Date"
                role="outputOnly"
            />

            <property
                name="selectedStockBatchTiter"
                type="String"
                label="Selected Stock Batch Titer"
                role="outputOnly"
            />

            <property
                name="selectedStockBatchEndVolume"
                type="String"
                label="Selected Stock Batch End Volume"
                role="outputOnly"
            />

            <property
                name="selectedStockBatchTubes"
                type="Integer"
                label="Selected Stock Batch Available Tubes"
                role="outputOnly"
            />

        </targetConfig>

    </targetConfigs>

</LightningComponentBundle>